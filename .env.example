# ============================================================
# ESX to Scale Migration Tool - Environment Configuration
# ============================================================
# Copy this file to .env and edit as needed:
#   cp .env.example .env

# Web UI port
ESX2SCALE_PORT=8080

# Maximum parallel migration jobs
MAX_CONCURRENT_JOBS=2

# Timezone (used for log timestamps and UI display)
TZ=America/New_York

# Container memory limit (increase for large VM conversions)
MEMORY_LIMIT=8g

# Optional: override internal data paths
# ESX2SCALE_DB_PATH=/data/db/esx2scale.db
# ESX2SCALE_CONVERSION_DIR=/data/conversions
# ESX2SCALE_VDDK_DIR=/data/vddk
# ESX2SCALE_LOG_DIR=/data/logs
